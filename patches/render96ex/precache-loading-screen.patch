 }
 
 // calls import_texture() on every texture in the res folder
+// Gamepi: precaching the HD texture pack takes long enough that the window
+// must show something; until the first buffer swap the launcher stays visible.
+#ifdef RAPI_GL
+#include "gfx_opengl.h"
+static uint32_t preload_total = 0;
+static uint32_t preload_done = 0;
+
+static bool count_texture(void *user, const char *path) {
+    (void)user;
+    (void)path;
+    preload_total++;
+    return true;
+}
+
+static void show_preload_progress(void) {
+    uint32_t width = 0, height = 0;
+    gfx_wapi->handle_events();
+    gfx_wapi->get_dimensions(&width, &height);
+    gfx_opengl_draw_loading(preload_total ? (float)preload_done / preload_total : 0.0f, width, height);
+    gfx_wapi->swap_buffers_begin();
+    gfx_wapi->swap_buffers_end();
+}
+#endif
+
 // we can get the format and size from the texture files
 // and then cache them using gfx_texture_cache_lookup
 static bool preload_texture(void *user, const char *path) {
+#ifdef RAPI_GL
+    if (++preload_done % 16 == 0) show_preload_progress();
+#endif
     // strip off the extension
     char texname[SYS_MAX_PATH];
     strncpy(texname, path, sizeof(texname));
@@ -1953,6 +1980,10 @@ void gfx_init(struct GfxWindowManagerAPI *wapi, struct GfxRenderingAPI *rapi, co
 }
 
 void gfx_precache_textures(void) {
+#ifdef RAPI_GL
+    fs_walk(FS_TEXTUREDIR, count_texture, NULL, true);
+    show_preload_progress();
+#endif
     // preload all textures
     fs_walk(FS_TEXTUREDIR, preload_texture, NULL, true);
 }
diff --git a/src/pc/gfx/gfx_sdl2.c b/src/pc/gfx/gfx_sdl2.c
index aa0ba6a..94c2faa 100644
--- a/src/pc/gfx/gfx_sdl2.c
+++ b/src/pc/gfx/gfx_sdl2.c
@@ -360,6 +360,9 @@ static inline void sync_framerate_with_timer(void) {
     static Uint32 last_time = 0;
     // get base timestamp on the first frame (might be different from 0)
     if (last_time == 0) last_time = SDL_GetTicks();
+    // Gamepi: after a stall such as texture precaching, where buffer swaps are
+    // far apart, resynchronize instead of running frames unthrottled to catch up.
+    if (SDL_GetTicks() - last_time > 250) last_time = SDL_GetTicks() - frame_time;
     const int elapsed = SDL_GetTicks() - last_time;
     if (elapsed < frame_time)
         SDL_Delay(frame_time - elapsed);
