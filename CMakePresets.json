{
  "version": 6,
  "configurePresets": [
    {
      "name": "probes",
      "displayName": "Linux ARM64 cross-compilation probes",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/probes",
      "toolchainFile": "${sourceDir}/toolchain/cmake/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "probes",
      "configurePreset": "probes",
      "targets": ["hello", "sdl-probe"]
    }
  ]
}
