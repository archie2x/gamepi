#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    systemd-sysusers /usr/lib/sysusers.d/gamepi.conf
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/gamepi.conf
    while IFS= read -r member; do
        case "$member" in ''|\#*) continue ;; esac
        if id "$member" >/dev/null 2>&1; then adduser "$member" gamepi; fi
    done < /etc/gamepi/library-editors
    if [ -z "${2:-}" ]; then
        chgrp -R gamepi /srv/ROMs /srv/BIOS
        find /srv/ROMs /srv/BIOS -type d -exec chmod 2775 {} +
        find /srv/ROMs /srv/BIOS -type f -exec chmod 0664 {} +
        find /srv/ROMs /srv/BIOS -type d -exec setfacl -m d:u::rwx,d:g::rwx,d:m::rwx,d:o::r-x {} +
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        deb-systemd-helper enable gamepi-kiosk.target >/dev/null
    fi
fi
